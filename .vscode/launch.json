{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mark2 HTML",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-f",
                "html",
                "./tests/assets/TEST-CONTAINER.md",
                "-o",
                "-"
            ]
        },
        {
            "name": "mark2 ConTeXt",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-f",
                "pdf",
                "./tests/assets/TEST-CONTEXT.md",
                "--keep-tex",
                "--debug-tokens"
            ]
        },
        {
            "name": "mark2 Greco Antico",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "-f",
                "pdf",
                "~/work/epub/grecoantico/grecoantico.md",
                "-o",
                "~/tmp/",
                "--keep-tex",
                "--debug-tokens"
            ]
        },
        {
            "name": "mark2 EPUB",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "./tests/assets/TEST-PAGEBREAK.md",
                "-o",
                "~/tmp",
                "-f",
                "epub"
            ]
        },
        {
            "name": "mark2 FRONTMATTER",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "./tests/assets/TEST-FRONTMATTER.md",
                "-o",
                "~/tmp/TEST-FRONTMATTER.epub"
            ]
        },
        {
            "name": "mark2 MARKDOWN",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "./tests/assets/TEST-LIST.md",
                "-o",
                "-",
                "-f",
                "md",
            ]
        },
        {
            "name": "mark2 --reference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/mark2/main.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--reference",
                "./tests/assets/TEST-CONTEXT.md",
            ]
        },
        {
            "name": "list_test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/list_test.py",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        },
        {
            "name": "test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "internalConsole",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/tests"
            },
            "args": [
                "tests/mark2/renderer/test_md.py",
                "-v"
            ]
        },
    ]
}